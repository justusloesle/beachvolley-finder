# Copy this file to `.env` and fill in your real keys.
#   cp .env.example .env
# `.env` is gitignored and must never be committed.

# Google Maps Platform key, used by the Routes API in beach_finder/geo.py.

GOOGLE_MAPS_API_KEY=

# Anthropic API key, used for the LLM ranking layer.

GEMINI_API_KEY=

# Telegram BotFather Api-Key, used for daily autonomous updates.
TELEGRAM_BOT_TOKEN=